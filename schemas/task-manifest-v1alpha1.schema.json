{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NDDev-it-com/agent-runtime/schemas/task-manifest-v1alpha1.schema.json",
  "title": "agent-runtime Task manifest v1alpha1",
  "x-license": "AGPL-3.0-only",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "instructions", "command", "acceptance"],
  "properties": {
    "schema_version": { "const": "v1alpha1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "description": { "type": "string" },
    "instructions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "acceptance": {
      "type": "object", "additionalProperties": false, "required": ["exit_codes"],
      "properties": {
        "exit_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
        "output_contains": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "workdir": { "type": "string", "default": "." },
    "env": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } },
    "timeout": { "type": "string", "default": "5m" },
    "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864, "default": 1048576 },
    "max_context_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216, "default": 1048576 }
  }
}
