{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NDDev-it-com/agent-runtime/schemas/goal-journal-v1alpha1.schema.json",
  "title": "agent-runtime Goal journal v1alpha1",
  "x-license": "AGPL-3.0-only",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "goal"],
  "properties": {
    "schema_version": { "const": "v1alpha1" },
    "revision": { "type": "integer", "minimum": 1 },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "intent", "acceptance", "state", "current_phase", "receipts", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
        "intent": { "type": "string", "minLength": 1 },
        "acceptance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/checklistItem" } },
        "non_goals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "state": { "enum": ["active", "completed"] },
        "current_phase": { "$ref": "#/$defs/phase" },
        "receipts": { "type": "object", "additionalProperties": { "$ref": "#/$defs/receipt" } },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "phase": { "enum": ["orient", "gap_plan", "execute", "reconcile", "self_review", "completeness_omission_audit", "verify", "closure"] },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "reference", "result"],
      "properties": {
        "type": { "enum": ["command", "file", "link", "commit", "test", "issue"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "result": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "checklistItem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "acceptance", "status"],
      "properties": {
        "id": { "type": "string" }, "acceptance": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "complete"] },
        "evidence": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "summary", "evidence", "recorded_at"],
      "properties": {
        "phase": { "$ref": "#/$defs/phase" }, "summary": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/evidence" } },
        "recorded_at": { "type": "string", "format": "date-time" },
        "closure": { "$ref": "#/$defs/closure" }
      }
    },
    "closure": {
      "type": "object", "additionalProperties": false,
      "required": ["achieved_outcome", "cleanup", "remaining", "next_work"],
      "properties": {
        "achieved_outcome": { "type": "string", "minLength": 1 },
        "cleanup": { "type": "string", "minLength": 1 },
        "remaining": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["kind", "summary"],
          "properties": { "kind": { "enum": ["debt", "risk"] }, "summary": { "type": "string", "minLength": 1 } }
        } },
        "next_work": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/evidence" } }
      }
    }
  }
}
