{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NDDev-it-com/agent-runtime/schemas/release-manifest-v1alpha1.schema.json",
  "x-license": "AGPL-3.0-only",
  "title": "agent-runtime release manifest v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "source_tag", "source_commit", "source_commit_time", "module_path", "go_compatibility", "license", "dependencies", "workflow", "actions", "sbom_namespace", "content_assets", "required_assets"],
  "properties": {
    "schema_version": {"const": "v1alpha1"},
    "version": {"pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "source_tag": {"type": "string"},
    "source_commit": {"pattern": "^[0-9a-f]{40}$"},
    "source_commit_time": {"type": "string", "format": "date-time"},
    "module_path": {"type": "string"},
    "go_compatibility": {"type": "string"},
    "license": {"const": "AGPL-3.0-only"},
    "dependencies": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [
      {"type": "object", "additionalProperties": false, "required": ["module_path", "version", "license"], "properties": {"module_path": {"const": "golang.org/x/mod"}, "version": {"const": "v0.27.0"}, "license": {"const": "BSD-3-Clause"}}},
      {"type": "object", "additionalProperties": false, "required": ["module_path", "version", "license"], "properties": {"module_path": {"const": "golang.org/x/sys"}, "version": {"const": "v0.40.0"}, "license": {"const": "BSD-3-Clause"}}}
    ], "items": false},
    "workflow": {"type": "string"},
    "actions": {"type": "object", "additionalProperties": false, "required": ["checkout", "setup_go", "attest_provenance", "attest_sbom"], "properties": {"checkout": {"type": "string"}, "setup_go": {"type": "string"}, "attest_provenance": {"type": "string"}, "attest_sbom": {"type": "string"}}},
    "sbom_namespace": {"type": "string", "format": "uri"},
    "content_assets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "size", "sha256"],
        "properties": {
          "name": {"type": "string"},
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "required_assets": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "string"}}
  }
}
