{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nddev-it-com.github.io/agent-runtime/schemas/repository-governance-v1alpha1.schema.json",
  "title": "Agent Runtime Repository Governance Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "policy", "required_effective_rules", "required_checks"],
  "properties": {
    "schema_version": {"const": "v1alpha1"},
    "repository": {"type": "object", "additionalProperties": false, "required": ["owner", "name", "default_branch", "allow_auto_merge"], "properties": {"owner":{"const":"NDDev-it-com"},"name":{"const":"agent-runtime"},"default_branch":{"const":"main"},"allow_auto_merge":{"const":true}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["name","enforcement","target","include","exclude","bypass_actors","strict","require_pull_request","required_approvals","require_code_owner_review","require_last_push_approval","require_review_thread_resolution","allowed_merge_methods","require_merge_queue","required_deployments"], "properties": {"name":{"type":"string","minLength":1},"enforcement":{"const":"active"},"target":{"const":"branch"},"include":{"const":["~DEFAULT_BRANCH"]},"exclude":{"const":[]},"bypass_actors":{"const":[]},"strict":{"const":true},"require_pull_request":{"const":true},"required_approvals":{"const":0},"require_code_owner_review":{"const":false},"require_last_push_approval":{"const":false},"require_review_thread_resolution":{"const":false},"allowed_merge_methods":{"const":["merge","squash","rebase"]},"require_merge_queue":{"const":false},"required_deployments":{"const":[]}}},
    "required_effective_rules": {"const":["deletion","non_fast_forward","required_signatures"]},
    "required_checks": {"type": "array", "minItems": 4, "maxItems": 4}
  },
  "x-license": "AGPL-3.0-only"
}
